PORT=3001

# Секрет для подписи JWT — сгенерируйте: openssl rand -hex 32
JWT_SECRET=change_me

# true, если панель работает за HTTPS (через Caddy/nginx). Иначе оставьте false —
# иначе cookie с сессией не будет отправляться браузером.
COOKIE_SECURE=false

AWG_CONTAINER=skdsh-awg
AWG_INTERFACE=awg0
AWG_CONFIG_PATH=/etc/amnezia/amneziawg/awg0.conf

SERVER_ENDPOINT=IP_СЕРВЕРА:39001
SERVER_DISPLAY_NAME=Mr. Skdsh VPN
SERVER_PUBLIC_KEY=
SERVER_PRESHARED_KEY=

AWG_JC=
AWG_JMIN=
AWG_JMAX=
AWG_S1=
AWG_S2=
AWG_S3=
AWG_S4=
AWG_H1=
AWG_H2=
AWG_H3=
AWG_H4=

PEER_ADDRESS_START=2
PEER_SUBNET_PREFIX=10.9.1.
PEER_SUBNET_MASK=/32
CLIENT_DNS=1.1.1.1

# Код-приглашение — необязателен, можно оставить пустым, если используете
# CAPTCHA ниже вместо него (или вообще без защиты, не рекомендуется)
REGISTRATION_INVITE_CODE=

# Cloudflare Turnstile — бесплатная защита от ботов при регистрации, без
# вашего участия (реальные люди просто щёлкают галочку). Получить ключи:
# dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Уведомления в Telegram (необязательно) — создайте бота через @BotFather,
# узнайте свой chat_id через @userinfobot, впишите оба значения
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
